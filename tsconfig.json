{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2024",
    "moduleResolution": "node",
    "outDir": "out",
    "lib": ["ES2024"],
    "sourceMap": true,
    "rootDir": "src",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["out/**/*", "scripts/**/*"]
}
