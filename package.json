{
  "name": "koishi-dev",
  "displayName": "Koishi Dev",
  "publisher": "MaikoTan",
  "description": "VSCode extension for Koishi developers",
  "version": "0.0.4",
  "license": "AGPL-3.0",
  "engines": {
    "vscode": "^1.140.0"
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile && yarn run convert",
    "compile": "tsc -p ./",
    "convert": "tsx ./scripts/convert.ts",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "repository": {
    "type": "git+https",
    "url": "https://github.com/MaikoTan/vscode-koishi-dev.git"
  },
  "bugs": {
    "url": "https://github.com/MaikoTan/vscode-koishi-dev/issues"
  },
  "author": {
    "name": "MaikoTan",
    "email": "maiko.tan.coding@gmail.com",
    "url": "https://github.com/MaikoTan"
  },
  "icon": "koishi.png",
  "categories": [
    "Snippets",
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "koishi",
    "develop",
    "json schema",
    "snippets",
    "yaml",
    "completion"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "package.json",
        "url": "./schemata/package-json.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "koishi.yml",
        "url": "./schemata/koishi-yml.json"
      }
    ],
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/koishi.common.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/koishi.common.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/koishi.common.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/koishi.common.json"
      }
    ]
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/glob": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.12.0",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.2",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0"
  }
}
